#!/usr/bin/env python3
"""gani-translate - machine translate a .vtt subtitle file, keeping its timings.

Used by gani-cli as a last resort when an episode offers none of the preferred
subtitle languages. Talks to Google's key-less translate endpoint, batching many
cues per request. Everything stays offline except that one endpoint.

    gani-translate [--referer URL] [--from CODE] [--to CODE] [--batch N] INPUT OUTPUT

INPUT is a subtitle URL or a local file, OUTPUT is the .vtt to write.
Writes OUTPUT atomically, so an interrupted run never leaves a half file behind.
"""
import argparse
import html
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

USER_AGENT = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
              "(KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36")

# clients5 returns one plain string per query; the /single endpoint returns
# sentence segments per query. Both were reachable from the target machine while
# the usual client=gtx endpoint answers 429.
ENDPOINTS = (
    ("https://clients5.google.com/translate_a/t?client=dict-chrome-ex", "flat"),
    ("https://translate.googleapis.com/translate_a/single?client=dict-chrome-ex&dt=t", "segments"),
)

MARKUP_RE = re.compile(r"<[^>]*>|\{\\[^}]*\}")
TIMING_RE = re.compile(r"^\s*\d{1,2}:\d{2}(?::\d{2})?[\.,]\d{1,3}\s*-->")
WS_RE = re.compile(r"[ \t]+")

BATCH = 100


def log(message):
    sys.stderr.write("gani-translate: %s\n" % message)
    sys.stderr.flush()


def http_get(url, referer=None, timeout=30):
    request = urllib.request.Request(url)
    request.add_header("User-Agent", USER_AGENT)
    if referer:
        request.add_header("Referer", referer)
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return response.read().decode("utf-8", "replace")


def http_post(url, fields, timeout=60):
    body = urllib.parse.urlencode(fields).encode()
    request = urllib.request.Request(url, data=body)
    request.add_header("User-Agent", USER_AGENT)
    request.add_header("Content-Type", "application/x-www-form-urlencoded")
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return response.read().decode("utf-8", "replace")


def clean_text(text):
    """drop markup the translator would mangle and normalise whitespace"""
    text = MARKUP_RE.sub("", text)
    text = html.unescape(text)
    text = WS_RE.sub(" ", text).strip()
    # a stray angle bracket would be read as subtitle markup by the player
    return text.replace("<", "").replace(">", "")


def parse_vtt(text):
    """-> list of (cue_id, timing_line, text); header blocks are dropped"""
    cues = []
    for block in re.split(r"\r?\n\s*\r?\n", text.strip()):
        lines = [line.rstrip() for line in block.splitlines()]
        lines = [line for line in lines if line.strip()]
        if not lines:
            continue
        timing_at = next((i for i, line in enumerate(lines) if TIMING_RE.match(line)), None)
        if timing_at is None:
            continue  # WEBVTT header, NOTE, STYLE
        cue_id = "\n".join(lines[:timing_at])
        body = clean_text(" ".join(lines[timing_at + 1:]))
        if not body:
            continue
        cues.append((cue_id, lines[timing_at].strip(), body))
    return cues


def render_vtt(cues, translated, source_label):
    out = ["WEBVTT", "", "NOTE machine translated from %s by gani-translate" % source_label, ""]
    for (cue_id, timing, _), text in zip(cues, translated):
        if cue_id:
            out.append(cue_id)
        out.append(timing)
        out.append(text.replace("&", "&amp;"))
        out.append("")
    return "\n".join(out) + "\n"


def _decode(body, shape, expected):
    data = json.loads(body)
    if shape == "flat":
        if data and isinstance(data[0], list):
            result = [item[0] if isinstance(item, list) and item else "" for item in data]
        else:
            result = [item for item in data]
    else:
        result = []
        for item in data:
            if isinstance(item, list):
                result.append("".join(seg[0] for seg in item
                                      if isinstance(seg, list) and seg and isinstance(seg[0], str)))
    return result if len(result) == expected else None


def translate_once(texts, source, target, endpoint, shape, attempts=3):
    url = "%s&sl=%s&tl=%s" % (endpoint, urllib.parse.quote(source), urllib.parse.quote(target))
    fields = [("q", text) for text in texts]
    last_error = None
    for attempt in range(attempts):
        try:
            body = http_post(url, fields)
            result = _decode(body, shape, len(texts))
            if result is not None:
                return result
            last_error = "unexpected response shape"
        except urllib.error.HTTPError as error:
            last_error = "http %s" % error.code
            if error.code in (429, 500, 502, 503, 504):
                time.sleep(2 ** attempt)
                continue
            break
        except Exception as error:  # network, json, ...
            last_error = str(error)
            time.sleep(2 ** attempt)
    raise RuntimeError(last_error or "request failed")


def translate_texts(texts, source, target):
    """batched, with per-cue retry so one bad batch cannot lose the whole file"""
    result = []
    for index, (endpoint, shape) in enumerate(ENDPOINTS):
        try:
            for start in range(0, len(texts), BATCH):
                chunk = texts[start:start + BATCH]
                try:
                    result.extend(translate_once(chunk, source, target, endpoint, shape))
                except Exception as error:
                    log("batch failed (%s), retrying cue by cue" % error)
                    result.extend(translate_once([text], source, target, endpoint, shape)[0]
                                  for text in chunk)
                log("%d/%d cues" % (min(start + BATCH, len(texts)), len(texts)))
            return result
        except Exception as error:
            log("endpoint %s failed: %s" % (urllib.parse.urlsplit(endpoint).netloc, error))
            result = []
    raise RuntimeError("all translation endpoints failed")


def write_atomic(path, text):
    directory = os.path.dirname(os.path.abspath(path))
    if directory:
        os.makedirs(directory, exist_ok=True)
    temporary = "%s.tmp%d" % (path, os.getpid())
    with open(temporary, "w", encoding="utf-8") as handle:
        handle.write(text)
    os.replace(temporary, path)


def main(argv=None):
    global BATCH
    parser = argparse.ArgumentParser(prog="gani-translate", add_help=True)
    parser.add_argument("input")
    parser.add_argument("output")
    parser.add_argument("--referer", default=None)
    parser.add_argument("--from", dest="source", default="auto")
    parser.add_argument("--to", dest="target", default="en")
    parser.add_argument("--batch", type=int, default=100)
    parser.add_argument("--source-label", default=None,
                        help="track label recorded in the output header")
    args = parser.parse_args(argv)
    BATCH = max(1, args.batch)

    try:
        if re.match(r"^https?://", args.input):
            raw = http_get(args.input, referer=args.referer)
        else:
            with open(args.input, encoding="utf-8", errors="replace") as handle:
                raw = handle.read()
    except Exception as error:
        log("cannot read %s: %s" % (args.input, error))
        return 1

    cues = parse_vtt(raw)
    if not cues:
        log("no usable cues in %s" % args.input)
        return 1

    log("translating %d cues from %s" % (len(cues), args.source))
    try:
        translated = translate_texts([cue[2] for cue in cues], args.source, args.target)
    except Exception as error:
        log("translation failed: %s" % error)
        return 1

    write_atomic(args.output, render_vtt(cues, translated, args.source_label or args.source))
    log("wrote %s" % args.output)
    return 0


if __name__ == "__main__":
    sys.exit(main())
